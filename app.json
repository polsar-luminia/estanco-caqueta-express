{
  "expo": {
    "name": "Estanco Caquetá Express",
    "slug": "estanco-caqueta-express",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "estancocaqueta",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1FAF55"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.estancocaqueta.express",
      "buildNumber": "2",
      "associatedDomains": [
        "applinks:estancocaqueta.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIViewControllerBasedStatusBarAppearance": true,
        "LSApplicationQueriesSchemes": ["whatsapp"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1FAF55"
      },
      "edgeToEdgeEnabled": true,
      "package": "co.estancocaqueta.express",
      "versionCode": 6
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "extraGradleProperties": {
              "org.gradle.jvmargs": "-Xmx4g -XX:MaxMetaspaceSize=2g"
            }
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1FAF55"
        }
      ],
      "react-native-edge-to-edge"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "669996b7-c230-4933-b487-ee4fadf0b90d"
      }
    },
    "owner": "luminia.agencia",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/669996b7-c230-4933-b487-ee4fadf0b90d"
    }
  }
}
