# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Secrets — never commit
# google-services.json NO se ignora: EAS empaqueta el proyecto respetando este
# archivo, asi que ignorarlo lo deja fuera del build y el prebuild de Android
# falla con ENOENT. Ademas no es un secreto — viaja dentro de cada APK
# publicado y cualquiera lo puede extraer. El secreto de verdad es la llave de
# servicio FCM, que vive en las credenciales de Expo y NO en el repositorio.
GoogleService-Info.plist
code-signing/private-key.pem

# gstack — reportes de seguridad internos
.gstack/

# IDE
.idea/

.env.local

# Google Play service account (EAS submit) — clave privada, NUNCA commitear
play-service-account.json

# Artefactos de build local (eas build --local)
*.ipa
*.aab
*.apk

# Artefactos del monkey (scripts/monkey-android.sh): logs por semilla, no se versionan
scripts/monkey-logs/
